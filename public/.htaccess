<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <IfModule mod_headers.c>

        Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Referrer-Policy "strict-origin"
#        Header always set Content-Security-Policy "\
#                    default-src 'self';\
#                    script-src 'self' *.digipatrol.id https://fonts.gstatic.com https://cdnjs.cloudflare.com  'unsafe-inline' 'unsafe-eval';\
#                    img-src 'self' *.digipatrol.id 'unsafe-inline' data: https:;\
#                    connect-src 'self' https://digipatrol.id https://fonts.gstatic.com https://cdnjs.cloudflare.com data: https:;\
#                    style-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com https://cdnjs.cloudflare.com  'unsafe-inline' 'unsafe-eval';\
#                    font-src 'self' https://fonts.gstatic.com https://www.w3.org https://cdnjs.cloudflare.com 'unsafe-inline' data: https:;\
#                    frame-src 'self' https://fonts.gstatic.com;\
#                    object-src 'self'; \
#                    form-action 'self'; \
#                    frame-ancestors 'self';"
